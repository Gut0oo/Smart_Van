# Copie para .env.local e troque pelo IP do PC que roda o back-end.
# No celular, localhost é o próprio celular. O celular e o PC precisam estar na mesma rede.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Com o backend no Docker, use http://IP_DO_PC:8081/api.
# Nesse caso, configure WEB_BIND=0.0.0.0 no .env da raiz e suba o Compose.
