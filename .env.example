# Copie para .env e preencha a senha antes de iniciar.
DB_PASSWORD=

# Opcional: sem chave, o backend usa o comportamento alternativo de mapas.
GOOGLE_MAPS_API_KEY=

# Acesso local. Na EC2, use WEB_BIND=0.0.0.0 e WEB_PORT=80.
WEB_BIND=127.0.0.1
WEB_PORT=8081

# Mesma tag nas duas imagens construídas e carregadas na EC2.
IMAGE_TAG=faculdade-v1
